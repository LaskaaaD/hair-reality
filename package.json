{
  "name": "hair-reality",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "worker:dev": "tsx watch src/worker/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/index.js",
    "worker:start": "node dist/worker/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "db:migrate": "tsx src/server/db/migrate-cli.ts",
    "db:seed": "tsx src/server/db/seed-cli.ts",
    "admin:reset-password": "tsx src/server/db/admin-cli.ts reset-password",
    "admin:grant-membership": "tsx src/server/db/admin-cli.ts grant-membership",
    "operator:import-photo": "tsx src/server/assets/import-cli.ts",
    "assets:expire": "tsx src/server/assets/expire-cli.ts",
    "demo:purge": "tsx src/server/demo/purge-cli.ts",
    "test:unit": "tsx --test tests/unit/*.ts",
    "test:integration": "tsx --test --test-timeout=300000 --test-concurrency=1 tests/integration/*.ts",
    "test:smoke": "tsx src/server/testing/smoke.ts",
    "verify": "tsx src/server/testing/verify-runner.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "motion": "14.2.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sharp": "0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
