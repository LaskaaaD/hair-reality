# Placeholder environment for Hair Reality. Copy to .env and replace local
# values there. This file is not a credential. Empty provider keys are correct
# for PROVIDER_MODE=fixture. Do not put real keys in this file.

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://hair_reality:replace-with-local-password@127.0.0.1:5434/hair_reality
TEST_DATABASE_URL=postgres://hair_reality:replace-with-local-password@127.0.0.1:5434/hair_reality_test
# Compose reads this name. It must match the password embedded in the database URLs above.
POSTGRES_PASSWORD=replace-with-local-password
# Empty values make the first seed generate passwords in gitignored var/seed-credentials.txt.
# Later seeds do not print those passwords or replace an existing hash.
SEED_CLIENT_PASSWORD=
SEED_STYLIST_PASSWORD=
SEED_ADMIN_PASSWORD=
SESSION_SECRET=replace-with-a-random-session-secret
# Keep 0 unless a trusted reverse proxy overwrites X-Forwarded-For. 1 trusts only that proxy.
TRUST_PROXY=0
PRIVATE_STORAGE_DIR=var/private
PROVIDER_MODE=fixture
BUDGET_PHASE=development
# Leave empty to use the official server https://yce-api-01.makeupar.com
YOUCAM_API_BASE_URL=
YOUCAM_API_KEY=
# Live task submission stays off until a later verified probe. Only the exact value 1 enables it.
YOUCAM_LIVE_SUBMISSION=
# The worker constructs live clients only when this is exactly 1. In PROVIDER_MODE=live, also set
# YOUCAM_LIVE_SUBMISSION=1 and PROVIDER_DOWNLOAD_ALLOWLIST so demo YouCam jobs are submitted and results downloaded.
HAIR_REALITY_OPERATOR_PROBE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Per-request timeout for OpenAI calls, in milliseconds (5000 to 120000, default 45000).
OPENAI_TIMEOUT_MS=
# Live OpenAI submission stays off until a later verified probe. Only the exact value 1 enables it.
OPENAI_LIVE_SUBMISSION=
YOUCAM_DEV_CAP=500
YOUCAM_DEMO_CAP=300
YOUCAM_TOTAL_CAP=800
YOUCAM_RESERVE=200
OPENAI_BUDGET_USD=6
ASSET_RETENTION_DAYS=30
DEMO_SALON_TIMEZONE=Europe/Warsaw
# hackathon uses YouCam analysis. salon uses the form and calls YouCam only when confidence is low.
ANALYSIS_MODE=hackathon
# Optional separate pool for judges. Leave the secret empty until a judge link is issued.
DEMO_JUDGE_SECRET=
DEMO_JUDGE_SESSION_CAP=120
DEMO_JUDGE_DAILY_CAP=400
DELETION_JOURNAL_MODE=local
DELETION_JOURNAL_DIR=var/deletion-journal
# Leave empty to allow only yce-us.s3-accelerate.amazonaws.com. Extra hosts must be exact names. No wildcards.
# Live demo example: yce-us.s3-accelerate.amazonaws.com,s3-us-west-2.amazonaws.com
PROVIDER_DOWNLOAD_ALLOWLIST=
# Set to 1 to make render jobs skip the render cache read (fresh renders for live tests; results are still written). Leave empty for normal use.
RENDER_CACHE_BYPASS=

# Production startup refuses local journal mode, placeholder secrets, an http
# APP_ORIGIN, and a relative private storage directory. Remote journal mode
# also requires BACKUP_HOST, BACKUP_PATH and DELETION_JOURNAL_PATH.
